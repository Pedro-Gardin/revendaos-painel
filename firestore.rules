rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function emailAuth() {
      return request.auth.token.email.lower();
    }

    function membership(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function ehMembro(orgId) {
      return logado() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function role(orgId) {
      return membership(orgId).data.role;
    }

    function ehDono(orgId) {
      return ehMembro(orgId) && role(orgId) == 'dono';
    }

    function criouAOrg(orgId) {
      return logado() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.criadoPor == request.auth.uid;
    }

    function cargoConviteOk(cargo) {
      return cargo in ['vendedor', 'financeiro', 'viewer'];
    }

    function conviteRef(orgId, conviteId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/convites/$(conviteId));
    }

    function conviteExiste(orgId, conviteId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/convites/$(conviteId));
    }

    // Convite pendente deste email, cargo bate, usado no aceite
    function convitePendenteValido(orgId, conviteId, cargo) {
      return logado()
        && conviteId is string
        && conviteExiste(orgId, conviteId)
        && conviteRef(orgId, conviteId).data.status == 'pendente'
        && conviteRef(orgId, conviteId).data.email == emailAuth()
        && conviteRef(orgId, conviteId).data.role == cargo
        && cargoConviteOk(cargo);
    }

    match /users/{uid} {
      allow read: if logado() && request.auth.uid == uid;

      // Atalho só depois de já ser membro (onboarding ou convite aceito)
      // ou no mesmo instante do aceite (membro criado imediatamente antes).
      allow create, update: if logado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['orgId', 'role'])
        && request.resource.data.role in ['dono', 'vendedor', 'financeiro', 'viewer']
        && (
          (ehMembro(request.resource.data.orgId) && role(request.resource.data.orgId) == request.resource.data.role)
          || (
            request.resource.data.keys().hasAny(['conviteId'])
            && convitePendenteValido(request.resource.data.orgId, request.resource.data.conviteId, request.resource.data.role)
          )
        );

      // Dono remove o atalho quando tira alguém da equipe
      allow delete: if logado() && (
        request.auth.uid == uid
        || (resource.data.orgId is string && ehDono(resource.data.orgId))
      );
    }

    // ─── Regra específica pra collection GROUP query ───
    // buscarConvitesPendentes() usa collectionGroup(db, 'convites') pra
    // procurar convites em TODAS as revendas ao mesmo tempo (a pessoa
    // convidada ainda não sabe o orgId). Uma regra aninhada normal
    // (organizations/{orgId}/convites/{conviteId}) NÃO autoriza esse
    // tipo de busca — o Firestore exige uma regra à parte com o
    // caminho curinga {path=**} pra liberar collection group queries.
    match /{path=**}/convites/{conviteId} {
      allow read: if logado() && resource.data.email == emailAuth();
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow create: if logado();
      allow update, delete: if ehDono(orgId);

      match /members/{uid} {
        allow read: if ehMembro(orgId);

        allow create: if
          // Onboarding: quem criou a org se registra como dono
          (logado() && request.auth.uid == uid && request.resource.data.role == 'dono' && criouAOrg(orgId))
          // Dono adiciona membro na mão
          || ehDono(orgId)
          // Aceite de convite pendente
          || (
            logado()
            && request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.conviteId is string
            && convitePendenteValido(orgId, request.resource.data.conviteId, request.resource.data.role)
          );

        allow update, delete: if ehDono(orgId);
      }

      match /convites/{conviteId} {
        allow read: if ehDono(orgId)
          || (logado() && resource.data.email == emailAuth());

        allow create: if ehDono(orgId)
          && request.resource.data.email is string
          && request.resource.data.status == 'pendente'
          && cargoConviteOk(request.resource.data.role);

        allow update: if ehDono(orgId) || (
          logado()
          && resource.data.status == 'pendente'
          && resource.data.email == emailAuth()
          && request.resource.data.status in ['aceito', 'recusado']
          && request.resource.data.aceitoPor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aceitoPor', 'aceitoEm'])
        );

        allow delete: if ehDono(orgId);
      }

      match /carros/{carroId} {
        allow read: if true;
        allow create, update, delete: if ehMembro(orgId) && role(orgId) != 'viewer';
      }

      match /financeiro/{docId} {
        allow read, write: if ehMembro(orgId) && role(orgId) in ['dono','financeiro'];
      }
      match /gastos/{docId} {
        allow read, write: if ehMembro(orgId) && role(orgId) in ['dono','financeiro'];
      }

      match /metas/{docId} {
        allow read: if ehMembro(orgId) && role(orgId) in ['dono','financeiro','vendedor','viewer'];
        allow write: if ehMembro(orgId) && role(orgId) in ['dono','financeiro'];
      }

      match /vendedores/{docId} {
        allow read: if ehMembro(orgId) && role(orgId) != 'viewer';
        allow write: if ehMembro(orgId) && role(orgId) in ['dono','financeiro'];
      }
      match /comissoes/{docId} {
        allow read: if ehMembro(orgId) && role(orgId) != 'viewer';
        allow write: if ehMembro(orgId) && role(orgId) in ['dono','financeiro'];
      }

      match /crm/{docId} {
        allow read, write: if ehMembro(orgId) && role(orgId) in ['dono','vendedor'];
      }

      match /contratos/{docId} {
        allow read, write: if ehMembro(orgId) && role(orgId) in ['dono','vendedor'];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
