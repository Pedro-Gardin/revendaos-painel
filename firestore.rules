rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Estoque — site público lê; só usuários logados alteram
    match /carros/{carroId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Dados internos — somente painel autenticado
    match /financeiro/{docId} {
      allow read, write: if request.auth != null;
    }

    match /gastos/{docId} {
      allow read, write: if request.auth != null;
    }

    match /metas/{docId} {
      allow read, write: if request.auth != null;
    }

    match /vendedores/{docId} {
      allow read, write: if request.auth != null;
    }

    match /comissoes/{docId} {
      allow read, write: if request.auth != null;
    }

    match /crm/{docId} {
      allow read, write: if request.auth != null;
    }

    // Bloqueia qualquer outra coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
